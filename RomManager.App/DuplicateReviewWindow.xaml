<Window x:Class="RomManager.App.DuplicateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Likely Duplicate Titles" Width="820" Height="620" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
      <StackPanel>
        <TextBlock Text="REVIEW LIKELY DUPLICATE TITLES" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource BrandGradientBrush}"/>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Margin="12" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="IsHitTestVisible" Value="True"/>
          <Setter Property="Focusable" Value="False"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding SystemName}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding SimilarityText}" Foreground="{StaticResource SecondaryTextBrush}"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="{Binding TitleA}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0">
                  <Run Text="{Binding FilesA, Mode=OneWay}"/><Run Text=" file(s)"/>
                </TextBlock>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="{Binding TitleB}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0">
                  <Run Text="{Binding FilesB, Mode=OneWay}"/><Run Text=" file(s)"/>
                </TextBlock>
              </StackPanel>

              <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Button Content="Keep This Title →" Click="KeepA_Click" Style="{StaticResource AccentButton}" ToolTip="Keep the left title and merge the right one into it"/>
                <Button Content="← Keep This Title" Click="KeepB_Click" Style="{StaticResource AccentButton}" ToolTip="Keep the right title and merge the left one into it"/>
                <Button Content="Not a Duplicate" Click="Dismiss_Click"/>
              </WrapPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Close" Click="Close_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
