<Window x:Class="RomManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, FallbackValue=ROM Manager}" Width="1380" Height="840" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource HeroWindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
      <StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="ROM MANAGER" FontSize="21" FontWeight="ExtraBold" Foreground="{StaticResource BrandGradientBrush}" VerticalAlignment="Center"/>
            <Border Margin="10,0,0,0" Padding="1" CornerRadius="10" BorderBrush="{StaticResource BrandGradientBrush}" BorderThickness="1" VerticalAlignment="Center">
              <Border Background="{StaticResource RaisedBrush}" CornerRadius="9" Padding="8,2">
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas"/>
              </Border>
            </Border>
            <TextBlock Text="Safe, read-only game library index" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
          </StackPanel>
          <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ChipButton}" Foreground="{StaticResource DangerBrush}"/>
          <Button DockPanel.Dock="Right" Content="Scan Now" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryChipButton}"/>
          <Button DockPanel.Dock="Right" Content="Add Folder" Command="{Binding AddFolderCommand}" Style="{StaticResource ChipButton}"/>
        </DockPanel>
        <WrapPanel>
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Margin="0,3,8,3" Padding="3">
            <StackPanel Orientation="Horizontal">
              <Button Content="Clean Up Titles" Command="{Binding CleanUpTitlesCommand}" Style="{StaticResource ChipButton}" ToolTip="Review suggested display-name fixes (rank prefixes, catalog names) for manual approval. Your files are never renamed."/>
              <Button Content="Merge Exact Duplicates" Command="{Binding MergeExactDuplicatesCommand}" Style="{StaticResource ChipButton}" ToolTip="Find games that share the exact same title within a system (often after Clean Up Titles) and merge them into one entry, so preferred-copy scoring and exports treat them as a single game."/>
              <Button Content="Review Duplicate Titles" Command="{Binding ReviewDuplicateTitlesCommand}" Style="{StaticResource ChipButton}" ToolTip="Find likely-duplicate game titles across the whole library for manual review and merge"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Margin="0,3,8,3" Padding="3">
            <StackPanel Orientation="Horizontal">
              <Button Content="Verify Catalog" Command="{Binding VerifyCatalogCommand}" Style="{StaticResource ChipButton}" ToolTip="Verify the selected system against trusted checksum catalogs"/>
              <CheckBox Content="Re-verify all" IsChecked="{Binding ForceFullReverify}" VerticalAlignment="Center" Margin="8,0,10,0" ToolTip="Off (default): only hash files that have never been checked or previously errored, so repeated runs are fast. On: re-check every file, including ones already verified."/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Margin="0,3,0,3" Padding="3">
            <StackPanel Orientation="Horizontal">
              <Button Content="Export Good Roms" Command="{Binding ExportPreferredLibraryCommand}" Style="{StaticResource ChipButton}" ToolTip="Copy every game's preferred, non-excluded version into a folder organized by system. Originals are never moved, renamed, or modified."/>
              <Button Content="Export Wanted Games" Command="{Binding ExportWantedLibraryCommand}" Style="{StaticResource ChipButton}" ToolTip="Copy only the games you've marked Wanted, using each one's preferred version, into a folder organized by system."/>
              <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ChipButton}" ToolTip="Export every indexed copy with its source, status, and hashes"/>
              <Button Content="Duplicate Report" Command="{Binding ExportDuplicateReportCommand}" Style="{StaticResource ChipButton}" ToolTip="Export a CSV of byte-identical duplicate files and how much disk space could be reclaimed by keeping one copy per group. Read-only - nothing is deleted."/>
            </StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*" MinWidth="450"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="135"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="SYSTEMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,2,0,7"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" DisplayMemberPath="DisplayText"
                   ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True"/>
          <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush}" Margin="0,11,0,11"/>
          <TextBlock Grid.Row="3" Text="SCAN LOCATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,0,7"/>
          <ListBox Grid.Row="4" ItemsSource="{Binding ScanLocations}" SelectedItem="{Binding SelectedLocation}" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="1,2">
                  <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                  <TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="Enabled: "/><Run Text="{Binding Enabled}"/><Run Text="   Recursive: "/><Run Text="{Binding Recursive}"/>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="5" Margin="0,7,0,0">
            <Button Content="{Binding LocationToggleLabel}" Command="{Binding ToggleLocationCommand}"/>
            <Button Content="{Binding RecursiveToggleLabel}" Command="{Binding ToggleRecursiveCommand}"/>
            <Button Content="Remove" Command="{Binding RemoveFolderCommand}"/>
          </WrapPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" ToolTip="Search title, filename, or path"/>
          <ComboBox Grid.Column="1" Margin="9,0,0,0" ItemsSource="{Binding LibraryFilters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Name" ToolTip="Filter the visible library"/>
        </Grid>
        <DockPanel Grid.Row="1" Margin="3,9,3,0" LastChildFill="False">
          <TextBlock Text="{Binding SelectedGamesCountText}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="4,0,10,0"/>
          <Button Content="Exclude Non-Preferred Copies" Command="{Binding ExcludeNonPreferredCommand}" ToolTip="For the selected games, keep only each game's preferred copy and exclude the rest"/>
          <Button Content="Clear Overrides" Command="{Binding ClearOverridesCommand}" ToolTip="Reset manual preferred/excluded choices back to automatic for the selected games"/>
          <Button Content="Mark Wanted" Command="{Binding MarkWantedCommand}" ToolTip="Mark the selected games as Wanted, so Export Wanted Games includes them"/>
          <Button Content="Unmark Wanted" Command="{Binding UnmarkWantedCommand}" ToolTip="Remove the selected games from your Wanted set"/>
        </DockPanel>
        <ListView x:Name="GamesListView" Grid.Row="2" Margin="3,11,3,0" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                  SelectionMode="Extended" SelectionChanged="GamesListView_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True">
          <ListView.View><GridView>
            <GridViewColumn Header="" Width="40">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Border Width="30" Height="30" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Loaded="ThumbnailCell_Loaded">
                    <Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/>
                  </Border>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="GAME" Width="260" DisplayMemberBinding="{Binding Title}"/>
            <GridViewColumn Header="SYSTEM" Width="165" DisplayMemberBinding="{Binding System}"/>
            <GridViewColumn Header="REGION" Width="80" DisplayMemberBinding="{Binding Region}"/>
            <GridViewColumn Header="★" Width="30" DisplayMemberBinding="{Binding WantedText}"/>
            <GridViewColumn Header="FILES" Width="65" DisplayMemberBinding="{Binding FileCount}"/>
            <GridViewColumn Header="SIZE" Width="75" DisplayMemberBinding="{Binding SizeText}"/>
            <GridViewColumn Header="DUPLICATES" Width="90" DisplayMemberBinding="{Binding DuplicateText}"/>
            <GridViewColumn Header="VERIFIED" Width="80" DisplayMemberBinding="{Binding VerifiedCount}"/>
            <GridViewColumn Header="STATUS" Width="95" DisplayMemberBinding="{Binding WorstStatus}"/>
          </GridView></ListView.View>
        </ListView>
      </Grid>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <Border Width="180" Height="168" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,12" HorizontalAlignment="Left">
              <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="4"/>
            </Border>
            <TextBlock Text="{Binding GameDetails.CanonicalTitle, FallbackValue=Select a game}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding GameDetails.SystemDefinition.Name}" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,16"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="VERSIONS / FILES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
          <ListBox Grid.Row="2" ItemsSource="{Binding DetailFiles}" SelectedItem="{Binding SelectedFile}" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="11" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <TextBlock Text="{Binding Region}" Foreground="{StaticResource AccentBrush}"/>
                      <TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Status}"/>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0">
                      <Run Text="Catalog: "/><Run Text="{Binding CatalogStatus}"/><Run Text="  "/><Run Text="{Binding CatalogSource}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding CatalogName}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="Preferred copy" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPreferred}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="Open Folder" Command="{Binding OpenFolderCommand}"/><Button Content="Copy Path" Command="{Binding CopyPathCommand}"/>
            <Button Content="Verify SHA-256" Command="{Binding VerifyHashCommand}"/>
            <Button Content="{Binding PreferCopyLabel}" Command="{Binding PreferCopyCommand}"/>
            <Button Content="{Binding ExcludeCopyLabel}" Command="{Binding ExcludeCopyCommand}"/>
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="{Binding Counts.Games, StringFormat={}{0:N0} Games}"/><TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}"/>
          <TextBlock Text="{Binding Counts.Files, StringFormat={}{0:N0} Files}"/><TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}"/>
          <TextBlock Text="{Binding Counts.Duplicates, StringFormat={}{0:N0} Duplicates}" Foreground="{StaticResource WarningBrush}"/>
          <TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}"/>
          <TextBlock Text="{Binding Counts.Missing, StringFormat={}{0:N0} Missing}" Foreground="{StaticResource DangerBrush}"/>
          <TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}"/>
          <TextBlock Text="{Binding Counts.Verified, StringFormat={}{0:N0} Verified}" Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="18,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding CurrentPath}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
      </Grid>
    </Border>
  </Grid>
</Window>
