<Window x:Class="RomManager.App.TitleCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean Up Titles" Width="880" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
      <StackPanel>
        <TextBlock Text="CLEAN UP TITLES" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource BrandGradientBrush}"/>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Margin="12" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="IsHitTestVisible" Value="True"/>
          <Setter Property="Focusable" Value="False"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding SystemName}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding Reason}" Foreground="{StaticResource SecondaryTextBrush}"/>
              </StackPanel>

              <StackPanel Grid.Row="1">
                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="CURRENT"/>
                <TextBlock Text="{Binding CurrentTitle}" TextWrapping="Wrap" Margin="0,1,0,6"/>
                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="SUGGESTED"/>
                <TextBlock Text="{Binding SuggestedTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,0"/>
              </StackPanel>

              <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Content="Apply" Click="Apply_Click" Style="{StaticResource AccentButton}" ToolTip="Rename this game in ROM Manager only — your files are never touched"/>
                <Button Content="Skip" Click="Skip_Click"/>
              </WrapPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Apply All" Click="ApplyAll_Click" ToolTip="Apply every remaining suggestion on this screen"/>
        <Button Content="Close" Click="Close_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
